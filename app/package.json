{
    "name": "connection-monitor-app",
    "version": "1.0.0",
    "main": "./public/main.js",
    "author": "이준영",
    "license": "ISC",
    "description": "",
    "scripts": {
        "start": "cls && npx tsc && electron ./public/main.js",
        "dev": "nodemon -e ts --watch ./src --exec npm start",
        "build:main": "npx tsc",
        "build:renderer": "cd ../renderer && npm run build",
        "prebuild": "npm run build:main && npm run build:renderer",
        "build": "electron-builder --config electron-builder.config.js",
        "dist": "npm run prebuild && npm run build"
    },
    "devDependencies": {
        "@types/electron": "^1.4.38",
        "@types/node": "^22.15.20",
        "electron": "^36.2.1",
        "electron-builder": "^26.0.12",
        "nodemon": "^3.1.10"
    }
}
